<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- PLC Settings -->
    <!-- PlcTagName: The specific tag in the PLC that triggers the PC shutdown sequence when its value changes.
         This tag is monitored continuously to initiate the automated shutdown process. -->
    <add key="PlcTagName" value="PC_KAPAT_V7" />
    
    <!-- PlcGateway: IP address of the Omron PLC device on the industrial network.
         Ensure this matches your PLC's network configuration. -->
    <add key="PlcGateway" value="192.168.250.1" />
    
    <!-- PlcPath: Communication path to the PLC device in format "rack,slot".
         Default is typically "1,0" for Omron PLCs in standard configurations. -->
    <add key="PlcPath" value="1,0" />
    
    <!-- PlcReadInterval: Frequency of PLC tag value checks in milliseconds.
         1000ms (1 second) for faster response time. -->
    <add key="PlcReadInterval" value="1000" />
    
    <!-- PlcTimeout: Maximum wait time for PLC response in milliseconds.
         2000ms allows for network latency while maintaining responsiveness. -->
    <add key="PlcTimeout" value="2000" />

    <!-- PLC Read Tag Settings -->
    <!-- PlcMaxRetries: Maximum attempts to read PLC tag before failing.
         3 retries for better reliability. -->
    <add key="PlcMaxRetries" value="3" />
    
    <!-- PlcInitialRetryDelayMs: Initial delay between retry attempts in milliseconds.
         1000ms for balanced retry sequence. -->
    <add key="PlcInitialRetryDelayMs" value="1000" />
    
    <!-- PlcMaxRetryDelayMs: Maximum delay between retries in milliseconds.
         2000ms caps the retry wait time. -->
    <add key="PlcMaxRetryDelayMs" value="2000" />

    <!-- PLC Initialize Settings -->
    <!-- PlcInitializeMaxRetries: Maximum attempts to establish initial PLC connection.
         4 retries for reliable initialization. -->
    <add key="PlcInitializeMaxRetries" value="4" />
    
    <!-- PlcInitializeInitialDelayMs: Initial startup connection retry delay in milliseconds.
         1500ms initial delay. -->
    <add key="PlcInitializeInitialDelayMs" value="1500" />
    
    <!-- PlcInitializeMaxDelayMs: Maximum initialization retry delay in milliseconds.
         3000ms maximum delay for balanced startup. -->
    <add key="PlcInitializeMaxDelayMs" value="3000" />
    
    <!-- PlcInitializeTotalTimeoutMs: Total allowed time for PLC initialization in milliseconds.
         20000ms (20 seconds) total timeout for initialization phase. -->
    <add key="PlcInitializeTotalTimeoutMs" value="20000" />
    
    <!-- Program Settings -->
    <!-- ProgramToClose: Display name of the Omron Soft-NA program for graceful shutdown.
         Must match exactly with the program's display name. -->
    <add key="ProgramToClose" value="Soft-NA" />
    
    <!-- ProcessToMonitor: Process name as shown in Windows Task Manager (lowercase).
         Used to verify program status during shutdown sequence. -->
    <add key="ProcessToMonitor" value="soft-na" />
    
    <!-- ProcessTerminationTimeout: Grace period in seconds for process termination.
         15 seconds allows essential data saving. -->
    <add key="ProcessTerminationTimeout" value="15" />
    
    <!-- ShutdownGracePeriod: Wait time in minutes before Windows shutdown.
         0.033 minutes (2 seconds) for immediate shutdown sequence. -->
    <add key="ShutdownGracePeriod" value="0.033" />
    
    <!-- ProcessCloseTimeout: Maximum wait time in milliseconds for process termination.
         3000ms (3 seconds) before force closing. -->
    <add key="ProcessCloseTimeout" value="3000" />
    
    <!-- Folder Cleanup Settings -->
    <!-- MaxFolderCount: Maximum number of log folders to keep per path.
         Prevents excessive disk usage while maintaining history. -->
    <add key="MaxFolderCount" value="15" />
    
    <!-- DaysThreshold: Age limit in days for log folders.
         Folders older than this will be deleted during cleanup. -->
    <add key="DaysThreshold" value="15" />
    
    <!-- FolderPaths: Semicolon-separated list of Soft-NA log folder paths.
         These paths are monitored and cleaned up based on MaxFolderCount and DaysThreshold. -->
    <add key="FolderPaths" value="C:\OMRON\Soft-NA\Storage\SDCard\OperationLog;C:\OMRON\Soft-NA\Storage\SDCard\Data Logging\Log Files\DataSet0;C:\OMRON\Soft-NA\Storage\SDCard\Data Logging\Log Files\DataSet1;C:\OMRON\Soft-NA\Storage\SDCard\Data Logging\Log Files\DataSet2" />

  </appSettings>
</configuration>